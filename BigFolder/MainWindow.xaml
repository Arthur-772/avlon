<Window x:Class="BigFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:BigFolder.Services"
        xmlns:viewModels="clr-namespace:BigFolder.ViewModels"
        Title="BigFolder"
        Width="246"
        Height="246"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="False"
        AllowDrop="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#E20F1114" />
        <SolidColorBrush x:Key="TileBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="TileHoverBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9BFFFFFF" />

        <Style x:Key="TileTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="GridTileStyle" TargetType="Border">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <DataTemplate x:Key="GridTileTemplate" DataType="{x:Type viewModels:TileViewModel}">
            <Border Style="{StaticResource GridTileStyle}" MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Grid>
                    <Image Source="{Binding Icon}"
                           Width="{Binding Source={x:Static services:GridMetrics.IconSize}}"
                           Height="{Binding Source={x:Static services:GridMetrics.IconSize}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSource}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <TextBlock Text="+"
                               FontSize="18"
                               Foreground="{StaticResource SubtleTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TileTextStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OverflowTileTemplate" DataType="{x:Type viewModels:TileViewModel}">
            <Border Style="{StaticResource GridTileStyle}" MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Grid>
                    <Image Source="{Binding OverflowIcon3}"
                           Width="26" Height="26"
                           Margin="16,8,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image Source="{Binding OverflowIcon2}"
                           Width="27" Height="27"
                           Margin="-5,0,5,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image Source="{Binding OverflowIcon1}"
                           Width="28" Height="28"
                           Margin="-24,10,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Background="#F20F1114"
                            CornerRadius="5"
                            Padding="4,0"
                            Height="15"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,4,0">
                        <TextBlock Text="{Binding OverflowBadge}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextBrush}"
                                   TextAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TileTextStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <viewModels:TileTemplateSelector x:Key="TileTemplateSelector"
                                       NormalTemplate="{StaticResource GridTileTemplate}"
                                       OverflowTemplate="{StaticResource OverflowTileTemplate}" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource CardBrush}"
            CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="退出 BigFolder" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid x:Name="CollapsedView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="BigFolder"
                           FontSize="10"
                           Foreground="{StaticResource SubtleTextBrush}"
                               Margin="10,4,0,0" />
                    <Button Content="×"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,2,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource SubtleTextBrush}"
                            ToolTip="Exit BigFolder"
                            Click="Exit_Click" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding GridTiles}"
                              Margin="5,0,5,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="3" Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl ContentTemplateSelector="{StaticResource TileTemplateSelector}"
                                            Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid x:Name="ExpandedView" Visibility="Collapsed" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="BigFolder"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <Button Content="收起"
                            Width="44"
                            Height="22"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="Collapse_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="8,0,4,8">
                    <ItemsControl x:Name="ExpandedItems" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:TileViewModel}">
                                <Border Width="86"
                                        Height="84"
                                        Margin="3"
                                        CornerRadius="7"
                                        Background="{StaticResource TileBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        AllowDrop="True"
                                        MouseLeftButtonDown="ExpandedTile_MouseLeftButtonDown"
                                        MouseMove="ExpandedTile_MouseMove"
                                        Drop="ExpandedTile_Drop"
                                        DragOver="ExpandedTile_DragOver"
                                        MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="上移" Click="MoveUp_Click" />
                                            <MenuItem Header="下移" Click="MoveDown_Click" />
                                            <MenuItem Header="移除" Click="RemoveItem_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Image Source="{Binding Icon}"
                                               Width="40" Height="40"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource TileTextStyle}"
                                                   Margin="6,58,6,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
